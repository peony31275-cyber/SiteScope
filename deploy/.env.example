# SiteScope deployment settings, read by deploy/compose.yaml. Copy this file to deploy/.env and
# set the secrets. deploy/.env is git-ignored: keep it private (chmod 600) and out of version
# control.
#
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Secrets (required) --------------------------------------------------------------------------
# The database owner (a superuser): migrations, backups and restores only.
DEPLOY_POSTGRES_OWNER_PASSWORD=
# The application role "sitescope_app" (rows only, no DDL, not a superuser): the API and the
# workers.
SITESCOPE_POSTGRES_PASSWORD=
SITESCOPE_REDIS_PASSWORD=

# Optional. Empty: the API is read-only for everyone (a write gets 403 writes_disabled), as for a
# public demo. Set to at least 32 random characters, and a write must carry
# "Authorization: Bearer <token>" (ADR-0024). The operator commands need no token: they run
# inside the stack (docs/deployment.md, "Operating the demo").
SITESCOPE_ADMIN_TOKEN=

# --- The public entry ----------------------------------------------------------------------------
# Where the frontend proxy listens on the host: the only published port. 127.0.0.1 keeps it
# on this machine (a local run); 0.0.0.0 publishes it. With HTTPS (compose.https.yaml), Caddy
# publishes 80 and 443 instead. Behind another proxy on the host, also mount
# deploy/nginx/real-ip.conf (docs/deployment.md, "Behind another proxy"), or every visitor
# shares one rate-limit budget.
DEPLOY_HTTP_BIND=127.0.0.1
DEPLOY_HTTP_PORT=8080

# HTTPS only (compose.https.yaml): the public DNS name of this server, and the email address
# Let's Encrypt may write to about the certificate.
DEPLOY_DOMAIN=
DEPLOY_ACME_EMAIL=

# --- Scale ---------------------------------------------------------------------------------------
DEPLOY_API_REPLICAS=1
DEPLOY_CRAWLER_REPLICAS=2
DEPLOY_INDEXER_REPLICAS=2

# --- Images --------------------------------------------------------------------------------------
# Built locally by "docker compose build" unless these name images from a registry.
DEPLOY_BACKEND_IMAGE=sitescope-backend:local
DEPLOY_FRONTEND_IMAGE=sitescope-frontend:local
DEPLOY_DEMO_SITE_IMAGE=sitescope-demo-site:local

# --- Crawl policy --------------------------------------------------------------------------------
# By default, the bundled demo site only. The application validates these at startup;
# production refuses localhost and IP addresses. The internal network has no route to the
# internet: approving a public host also needs egress for the crawlers (docs/deployment.md,
# "Crawling other sites").
SITESCOPE_CRAWL_ALLOWED_HOSTS=demo-site
SITESCOPE_CRAWL_ALLOWED_SCHEMES=http
SITESCOPE_CRAWL_ALLOWED_PORTS=8080
SITESCOPE_FETCH_INTERNAL_ORIGINS=http://demo-site:8080
SITESCOPE_CRAWL_MAX_DEPTH_LIMIT=5
SITESCOPE_CRAWL_MAX_PAGES_LIMIT=200
SITESCOPE_CRAWL_MAX_ACTIVE_JOBS=10

SITESCOPE_LOG_LEVEL=INFO
