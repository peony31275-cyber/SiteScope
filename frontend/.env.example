# SiteScope dashboard configuration. Copy to .env.local to change a value.
#
# VITE_ variables are PUBLIC: Vite embeds them in the JavaScript bundle that every visitor
# downloads. Never put a secret (password, token, key) in one.

# Base path of the SiteScope API as the browser sees it. Keep the same-origin default: the
# development and preview servers proxy /api to the API server (SITESCOPE_API_URL below), and
# a deployment's reverse proxy (nginx) does the same.
VITE_API_BASE_URL=/api/v1

# Default auto-refresh interval for running crawl jobs, in milliseconds (1000 to 60000). Each
# viewer can change it in the header; their choice is kept in the browser.
VITE_POLL_INTERVAL_MS=3000

# Development and preview servers only (never embedded in the bundle): where /api is proxied.
SITESCOPE_API_URL=http://127.0.0.1:8000
