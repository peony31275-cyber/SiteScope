# SiteScope backend configuration template.
#
# Copy this file to backend/.env for local development (`.env` is git-ignored). Two consumers read
# that file:
#   * the backend (pydantic-settings); real environment variables take precedence over it;
#   * backend/compose.yaml, which takes the container credentials and ports from it.
# Keeping both on one file means the containers and the application always agree on credentials.
#
# backend/.env may contain only the SITESCOPE_ settings listed here. The application refuses to
# start if a value is invalid or if the file contains any other key, including a misspelled one.
# Never commit real secrets. The passwords below are placeholders for a local development
# environment whose ports are bound to 127.0.0.1; replace them with your own values.

# Deployment environment: development | test | production
# In production, the PostgreSQL and Redis passwords are mandatory.
SITESCOPE_ENVIRONMENT=development

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
SITESCOPE_LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------------------------------
# PostgreSQL applies these credentials only when it creates its data volume for the first time.
# Changing them later requires ALTER ROLE in the database, or a reset of the development volume
# (see docs/development.md).
SITESCOPE_POSTGRES_HOST=127.0.0.1
SITESCOPE_POSTGRES_PORT=5432
SITESCOPE_POSTGRES_USER=sitescope
SITESCOPE_POSTGRES_PASSWORD=change-me-local-postgres-password
SITESCOPE_POSTGRES_DB=sitescope

# Connection pool (per process): pool size, extra connections allowed under load, and seconds to
# wait for a free connection before failing.
SITESCOPE_DB_POOL_SIZE=5
SITESCOPE_DB_MAX_OVERFLOW=5
SITESCOPE_DB_POOL_TIMEOUT_SECONDS=5
# Seconds allowed to open a connection, and the per-statement client-side timeout.
SITESCOPE_DB_CONNECT_TIMEOUT_SECONDS=5
SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS=30

# --- Redis ---------------------------------------------------------------------------------------
SITESCOPE_REDIS_HOST=127.0.0.1
SITESCOPE_REDIS_PORT=6379
SITESCOPE_REDIS_PASSWORD=change-me-local-redis-password
SITESCOPE_REDIS_DB=0
# Seconds allowed to connect, and to wait for a reply.
SITESCOPE_REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Health checks -------------------------------------------------------------------------------
# Seconds each dependency check in GET /api/v1/health/ready may take.
SITESCOPE_READINESS_TIMEOUT_SECONDS=2

# --- Crawl targets and limits --------------------------------------------------------------------
# Approved crawl targets, comma-separated. Empty (the default) approves nothing, so every crawl
# request is rejected until you list a target:
#   docs.example.com   exactly this host (not www.docs.example.com, not docs.example.com.evil.test)
#   *.example.org      every subdomain of example.org, but not example.org itself
# Development and test only (refused when SITESCOPE_ENVIRONMENT=production): localhost, names
# under .localhost, and IP addresses such as 127.0.0.1 or [::1].
# This check is not an SSRF defense on its own: docs/architecture.md, section 12.
SITESCOPE_CRAWL_ALLOWED_HOSTS=
# Schemes and ports a crawl target may use, comma-separated. The port is the explicit one, or
# the scheme's default (80 for http, 443 for https).
SITESCOPE_CRAWL_ALLOWED_SCHEMES=http,https
SITESCOPE_CRAWL_ALLOWED_PORTS=80,443
# The largest max_depth (0-50) and max_pages (1-100000) a crawl job may request.
SITESCOPE_CRAWL_MAX_DEPTH_LIMIT=5
SITESCOPE_CRAWL_MAX_PAGES_LIMIT=1000

# --- Safe fetcher --------------------------------------------------------------------------------
# Seconds allowed for DNS resolution, the TCP connection and the TLS handshake; for each read or
# write; and for a whole fetch, redirects included (this deadline stops slow-drip responses).
SITESCOPE_FETCH_CONNECT_TIMEOUT_SECONDS=10
SITESCOPE_FETCH_READ_TIMEOUT_SECONDS=10
SITESCOPE_FETCH_DEADLINE_SECONDS=60
# The largest response body after removing gzip or deflate (1024 to 10485760 bytes). A larger
# body is rejected, never truncated.
SITESCOPE_FETCH_MAX_BODY_BYTES=2097152
# Redirects followed per fetch (0 to 20); every target is validated again.
SITESCOPE_FETCH_MAX_REDIRECTS=5
# Exact origins (scheme://host[:port], comma-separated) that may resolve to private addresses,
# such as a self-hosted demo site; outside production, also to loopback addresses. Empty by
# default. Example for a local fixture server, together with the crawl settings above:
#   SITESCOPE_CRAWL_ALLOWED_HOSTS=localhost
#   SITESCOPE_CRAWL_ALLOWED_PORTS=8080
#   SITESCOPE_FETCH_INTERNAL_ORIGINS=http://localhost:8080
# Production refuses localhost, .localhost names and IP addresses here. Link-local addresses
# (including 169.254.169.254), multicast and reserved addresses are never reachable.
SITESCOPE_FETCH_INTERNAL_ORIGINS=

# --- HTML parsing --------------------------------------------------------------------------------
# Distinct links kept per page, and characters of visible text kept per page (at most 1000000).
SITESCOPE_PARSE_MAX_LINKS=1000
SITESCOPE_PARSE_MAX_TEXT_CHARS=1000000

# --- Crawling (Phase 4) ------------------------------------------------------------------------
# The crawler's name (RFC 9309 product token: letters, "_" and "-"). It is sent as
# "<name>/<version>" in User-Agent and matched against robots.txt user-agent lines and
# <meta name="..."> robots tags.
SITESCOPE_CRAWLER_NAME=SiteScopeBot
# URLs the single-process crawl driver (python -m app.workers.local_crawler) processes at once.
SITESCOPE_CRAWL_CONCURRENCY=4
# Lease of a claimed URL, by the PostgreSQL clock. Must be at least
# SITESCOPE_FETCH_DEADLINE_SECONDS + 10: a task stops 10 s before its lease ends.
SITESCOPE_CRAWL_LEASE_SECONDS=90
# Claims of one URL (crashed attempts included) before it fails as max_attempts_exceeded.
SITESCOPE_CRAWL_MAX_ATTEMPTS=3

# --- Politeness ----------------------------------------------------------------------------------
# Minimum seconds between the starts of two requests to one host, across every crawler process
# (shared through Redis). 0 disables the spacing; use it only for tests and local benchmarks.
SITESCOPE_POLITENESS_INTERVAL_SECONDS=1
# Requests in flight to one host at the same time, across every crawler process.
SITESCOPE_POLITENESS_MAX_CONCURRENT_PER_HOST=1
# The longest a request waits for its slot before it fails as rate_limited. Must be at least
# the interval and the maximum crawl delay.
SITESCOPE_POLITENESS_MAX_WAIT_SECONDS=30
# robots.txt results are cached for this long (60 to 86400; RFC 9309 allows at most 24 hours).
SITESCOPE_ROBOTS_CACHE_SECONDS=86400
# An unreachable robots.txt (5xx, 429, network error) disallows its whole origin; the result is
# cached this long before robots.txt is fetched again.
SITESCOPE_ROBOTS_RETRY_SECONDS=300
# Cap on a robots.txt Crawl-delay, which raises the host's interval (seconds).
SITESCOPE_ROBOTS_MAX_CRAWL_DELAY_SECONDS=10

# --- Redis keys ----------------------------------------------------------------------------------
# Prefix of every Redis key SiteScope writes: lowercase letters, digits, "_" and "-".
SITESCOPE_REDIS_KEY_PREFIX=sitescope
