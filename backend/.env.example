# SiteScope backend configuration template.
#
# Copy this file to backend/.env for local development (`.env` is git-ignored). Two consumers read
# that file:
#   * the backend (pydantic-settings); real environment variables take precedence over it;
#   * backend/compose.yaml, which takes the container credentials and ports from it.
# Keeping both on one file means the containers and the application always agree on credentials.
#
# backend/.env may contain only the SITESCOPE_ settings listed here. The application refuses to
# start if a value is invalid or if the file contains any other key, including a misspelled one.
# Never commit real secrets. The passwords below are placeholders for a local development
# environment whose ports are bound to 127.0.0.1; replace them with your own values.

# Deployment environment: development | test | production
# In production, the PostgreSQL and Redis passwords are mandatory.
SITESCOPE_ENVIRONMENT=development

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
SITESCOPE_LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------------------------------
# PostgreSQL applies these credentials only when it creates its data volume for the first time.
# Changing them later requires ALTER ROLE in the database, or a reset of the development volume
# (see docs/development.md).
SITESCOPE_POSTGRES_HOST=127.0.0.1
SITESCOPE_POSTGRES_PORT=5432
SITESCOPE_POSTGRES_USER=sitescope
SITESCOPE_POSTGRES_PASSWORD=change-me-local-postgres-password
SITESCOPE_POSTGRES_DB=sitescope

# Connection pool (per process): pool size, extra connections allowed under load, and seconds to
# wait for a free connection before failing.
SITESCOPE_DB_POOL_SIZE=5
SITESCOPE_DB_MAX_OVERFLOW=5
SITESCOPE_DB_POOL_TIMEOUT_SECONDS=5
# Seconds allowed to open a connection, and the per-statement client-side timeout.
SITESCOPE_DB_CONNECT_TIMEOUT_SECONDS=5
SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS=30

# --- Redis ---------------------------------------------------------------------------------------
SITESCOPE_REDIS_HOST=127.0.0.1
SITESCOPE_REDIS_PORT=6379
SITESCOPE_REDIS_PASSWORD=change-me-local-redis-password
SITESCOPE_REDIS_DB=0
# Seconds allowed to connect, and to wait for a reply.
SITESCOPE_REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Health checks -------------------------------------------------------------------------------
# Seconds each dependency check in GET /api/v1/health/ready may take.
SITESCOPE_READINESS_TIMEOUT_SECONDS=2

# --- Crawl targets and limits --------------------------------------------------------------------
# Approved crawl targets, comma-separated. Empty (the default) approves nothing, so every crawl
# request is rejected until you list a target:
#   docs.example.com   exactly this host (not www.docs.example.com, not docs.example.com.evil.test)
#   *.example.org      every subdomain of example.org, but not example.org itself
# Development and test only (refused when SITESCOPE_ENVIRONMENT=production): localhost, names
# under .localhost, and IP addresses such as 127.0.0.1 or [::1].
# This check is not an SSRF defense on its own: docs/architecture.md, section 12.
SITESCOPE_CRAWL_ALLOWED_HOSTS=
# Schemes and ports a crawl target may use, comma-separated. The port is the explicit one, or
# the scheme's default (80 for http, 443 for https).
SITESCOPE_CRAWL_ALLOWED_SCHEMES=http,https
SITESCOPE_CRAWL_ALLOWED_PORTS=80,443
# The largest max_depth (0-50) and max_pages (1-100000) a crawl job may request.
SITESCOPE_CRAWL_MAX_DEPTH_LIMIT=5
SITESCOPE_CRAWL_MAX_PAGES_LIMIT=1000

# --- Safe fetcher --------------------------------------------------------------------------------
# Seconds allowed for DNS resolution, the TCP connection and the TLS handshake; for each read or
# write; and for a whole fetch, redirects included (this deadline stops slow-drip responses).
SITESCOPE_FETCH_CONNECT_TIMEOUT_SECONDS=10
SITESCOPE_FETCH_READ_TIMEOUT_SECONDS=10
SITESCOPE_FETCH_DEADLINE_SECONDS=60
# The largest response body after removing gzip or deflate (1024 to 10485760 bytes). A larger
# body is rejected, never truncated.
SITESCOPE_FETCH_MAX_BODY_BYTES=2097152
# Redirects followed per fetch (0 to 20); every target is validated again.
SITESCOPE_FETCH_MAX_REDIRECTS=5
# Exact origins (scheme://host[:port], comma-separated) that may resolve to private addresses,
# such as a self-hosted demo site; outside production, also to loopback addresses. Empty by
# default. Example for a local fixture server, together with the crawl settings above:
#   SITESCOPE_CRAWL_ALLOWED_HOSTS=localhost
#   SITESCOPE_CRAWL_ALLOWED_PORTS=8080
#   SITESCOPE_FETCH_INTERNAL_ORIGINS=http://localhost:8080
# Production refuses localhost, .localhost names and IP addresses here. Link-local addresses
# (including 169.254.169.254), multicast and reserved addresses are never reachable.
SITESCOPE_FETCH_INTERNAL_ORIGINS=

# --- HTML parsing --------------------------------------------------------------------------------
# Distinct links kept per page, and characters of visible text kept per page (at most 1000000).
SITESCOPE_PARSE_MAX_LINKS=1000
SITESCOPE_PARSE_MAX_TEXT_CHARS=1000000

# --- Crawling (Phase 4) ------------------------------------------------------------------------
# The crawler's name (RFC 9309 product token: letters, "_" and "-"). It is sent as
# "<name>/<version>" in User-Agent and matched against robots.txt user-agent lines and
# <meta name="..."> robots tags.
SITESCOPE_CRAWLER_NAME=SiteScopeBot
# URLs one crawl process (a crawler worker, or the single-process driver) processes at once
# (1 to 64).
SITESCOPE_CRAWL_CONCURRENCY=4
# Lease of a claimed URL, by the PostgreSQL clock. Must be at least
# SITESCOPE_FETCH_DEADLINE_SECONDS + SITESCOPE_CRAWL_LEASE_MARGIN_SECONDS.
SITESCOPE_CRAWL_LEASE_SECONDS=90
# A task is cut off this many seconds before its lease ends, which leaves time to commit its
# result (task deadline = lease - margin).
SITESCOPE_CRAWL_LEASE_MARGIN_SECONDS=10
# Claims of one URL, retries and crashed attempts included. After the last one, a failure is
# final (a crashed last attempt fails as max_attempts_exceeded).
SITESCOPE_CRAWL_MAX_ATTEMPTS=3
# How often a crawler worker checks whether the jobs of its running tasks are being cancelled
# (POST /api/v1/crawls/{job_id}/cancel); it then stops those tasks (0 < seconds <= 60).
SITESCOPE_CRAWL_CANCEL_CHECK_SECONDS=2

# --- Retries (Phase 6) ---------------------------------------------------------------------------
# A retryable failure (temporary DNS failure, connection failure, timeout, truncated response,
# rate_limited, deadline_exceeded, infrastructure_error, or an HTTP status listed below) goes back
# to pending while attempts remain. Attempt n waits a random time between 0 and
# min(MAX_DELAY, BASE_DELAY * 2^(n-1)) seconds (full jitter), and at least a valid Retry-After.
# The base delay must not exceed the maximum delay.
SITESCOPE_RETRY_BASE_DELAY_SECONDS=2
SITESCOPE_RETRY_MAX_DELAY_SECONDS=60
# A Retry-After (HTTP 429 or 503) longer than this is not waited for: the failure is final.
SITESCOPE_RETRY_AFTER_MAX_SECONDS=300
# HTTP statuses that are retried, comma-separated: server errors (500-599), and of the client
# errors only 408, 425 and 429. Any other status (404 and 410 above all) is final.
SITESCOPE_RETRY_HTTP_STATUSES=429,500,502,503,504

# --- Redis Streams task delivery (Phase 5) -------------------------------------------------------
# Timing order, checked at startup: task deadline < lease <= reclaim min idle <= reconcile after
# <= retention.
# How long a worker's XREADGROUP waits for tasks; must be below the Redis socket timeout.
SITESCOPE_STREAM_READ_BLOCK_MS=2000
# How often a worker looks for tasks of crashed or stalled workers (XAUTOCLAIM), how long such a
# task must have been idle first (at least the lease), and how many it takes at a time.
SITESCOPE_STREAM_RECLAIM_INTERVAL_SECONDS=15
SITESCOPE_STREAM_RECLAIM_MIN_IDLE_SECONDS=100
SITESCOPE_STREAM_RECLAIM_BATCH_SIZE=50
# A task delivered more often than this without being settled, whose URL can no longer be
# claimed (its attempts are used up), is poison: the URL fails as max_deliveries_exceeded, and the
# message goes to the dead-letter stream (2 to 1000). Any other URL is claimed as usual.
SITESCOPE_STREAM_MAX_DELIVERIES=10
# Acknowledged stream entries older than this are trimmed (never undelivered or pending ones).
SITESCOPE_STREAM_RETENTION_SECONDS=3600
# Consumers (one per worker process start) with nothing pending are removed after this idle time.
SITESCOPE_STREAM_CONSUMER_MAX_IDLE_SECONDS=3600

# --- Scheduler (python -m app.scheduler, Phase 5) ------------------------------------------------
# The scheduler starts every queued job of its database. Never point it at a database whose
# queued jobs must not run.
# Seconds between two scheduler passes (activation, level advancement, dispatch).
SITESCOPE_SCHEDULER_INTERVAL_SECONDS=0.5
# Tasks published per job and pass.
SITESCOPE_SCHEDULER_DISPATCH_BATCH_SIZE=100
# Backpressure: tasks queued or in progress per job, and over all jobs.
SITESCOPE_SCHEDULER_MAX_IN_FLIGHT_PER_JOB=100
SITESCOPE_SCHEDULER_MAX_OUTSTANDING=1000
# Jobs running at the same time; the oldest queued jobs start first.
SITESCOPE_SCHEDULER_MAX_RUNNING_JOBS=10
# A queued task, or an expired lease, without progress for this long is published again if its
# stream entry is gone (for example after Redis lost its data).
SITESCOPE_SCHEDULER_RECONCILE_AFTER_SECONDS=300

# --- Indexing (Phase 7) ---------------------------------------------------------------------------
# Run `python -m app.scheduler.index_dispatcher` (one or more) and `python -m app.workers.indexer`
# (one or more) to index crawled pages. Timing order, checked at startup: task deadline + 2 <=
# reclaim min idle <= reconcile after <= SITESCOPE_STREAM_RETENTION_SECONDS, and task deadline <
# SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS.
# Index tasks one indexer process runs at once (1 to 64); each holds one database connection, so
# at most SITESCOPE_DB_POOL_SIZE + SITESCOPE_DB_MAX_OVERFLOW.
SITESCOPE_INDEX_CONCURRENCY=4
# Indexing attempts of one page before it fails for good (1 to 10), crashed attempts included.
SITESCOPE_INDEX_MAX_ATTEMPTS=3
# Characters of a page's body text that are indexed (1000 to 150000); titles, descriptions and
# headings are indexed whole. The default keeps search vectors below PostgreSQL's 1 MB limit for
# every text measured; a larger vector is built again from a quarter of the body.
SITESCOPE_INDEX_MAX_BODY_CHARS=100000
# An index attempt's deadline, for all its statements together; the attempt is then retried.
# Shorter than SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS.
SITESCOPE_INDEX_TASK_DEADLINE_SECONDS=20
# How long an index task must have been idle before another indexer takes it over (XAUTOCLAIM);
# at least the task deadline + 2.
SITESCOPE_INDEX_RECLAIM_MIN_IDLE_SECONDS=60
# A queued index task without progress this long is published again if its message is gone.
SITESCOPE_INDEX_RECONCILE_AFTER_SECONDS=300
# Index tasks published per dispatcher pass, and queued at most at any time.
SITESCOPE_INDEX_DISPATCH_BATCH_SIZE=200
SITESCOPE_INDEX_MAX_OUTSTANDING=1000
# Pause between two index dispatcher passes.
SITESCOPE_INDEX_DISPATCHER_INTERVAL_SECONDS=0.5
# A search is stopped after this long. Shorter than SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS.
SITESCOPE_SEARCH_TIMEOUT_SECONDS=5

# --- Website analysis (Phase 8) ------------------------------------------------------------------
# An analysis request (pages, links, broken links, link graph, statistics) is stopped after this
# long (0 < value <= 60). Shorter than SITESCOPE_DB_COMMAND_TIMEOUT_SECONDS.
SITESCOPE_ANALYSIS_TIMEOUT_SECONDS=10

# --- API (Phase 6) -------------------------------------------------------------------------------
# How long the Idempotency-Key of a POST /api/v1/crawls request is remembered (60 to 2592000
# seconds). Afterwards the key is forgotten (the job stays) and may create a new job.
SITESCOPE_IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Process shutdown ----------------------------------------------------------------------------
# On SIGINT or SIGTERM, how long a crawler worker lets running tasks finish before cancelling
# them (their messages stay pending and are recovered).
SITESCOPE_SHUTDOWN_GRACE_SECONDS=30

# --- Politeness ----------------------------------------------------------------------------------
# Minimum seconds between the starts of two requests to one host, across every crawler process
# (shared through Redis). 0 disables the spacing; use it only for tests and local benchmarks.
SITESCOPE_POLITENESS_INTERVAL_SECONDS=1
# Requests in flight to one host at the same time, across every crawler process.
SITESCOPE_POLITENESS_MAX_CONCURRENT_PER_HOST=1
# The longest a request waits for its slot before it fails as rate_limited. Must be at least
# the interval and the maximum crawl delay.
SITESCOPE_POLITENESS_MAX_WAIT_SECONDS=30
# A held request slot is a lease of this many seconds (1 to 600), renewed while its request runs.
# The slot of a crashed or frozen worker frees after at most one lease. No slot is held longer
# than SITESCOPE_FETCH_DEADLINE_SECONDS plus 10 seconds.
SITESCOPE_POLITENESS_SLOT_LEASE_SECONDS=15
# robots.txt results are cached for this long (60 to 86400; RFC 9309 allows at most 24 hours).
SITESCOPE_ROBOTS_CACHE_SECONDS=86400
# An unreachable robots.txt (5xx, 429, network error) disallows its whole origin; the result is
# cached this long before robots.txt is fetched again.
SITESCOPE_ROBOTS_RETRY_SECONDS=300
# Cap on a robots.txt Crawl-delay, which raises the host's interval (seconds).
SITESCOPE_ROBOTS_MAX_CRAWL_DELAY_SECONDS=10

# --- Redis keys ----------------------------------------------------------------------------------
# Prefix of every Redis key SiteScope writes: lowercase letters, digits, "_" and "-".
SITESCOPE_REDIS_KEY_PREFIX=sitescope
